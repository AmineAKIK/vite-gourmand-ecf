# ============================================
# VITE & GOURMAND — Variables d'environnement
# Copier vers .env et remplir les valeurs
# NE JAMAIS COMMITER .env
# ============================================

# Base de données MySQL
DB_HOST=localhost
DB_NAME=vite_gourmand
DB_USER=root
DB_PASS=

# Stripe (paiements CB en ligne — https://dashboard.stripe.com/apikeys)
# sk_test_... en dev, sk_live_... en prod
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret depuis le Stripe Dashboard → Webhooks → votre endpoint /stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Mail SMTP (ex: Mailtrap en dev, Brevo/SES en prod)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=votre_user_mailtrap
MAIL_PASS=votre_pass_mailtrap
MAIL_FROM=noreply@vitegourmand.fr
MAIL_FROM_NAME=Vite & Gourmand

# Application
BASE_URL=http://localhost:8080
APP_ENV=development
# APP_ENV=production  ← valeur à utiliser sur Railway

# Cycle de vie des migrations
# Production : les migrations sont exécutées par l'entrypoint Docker avant Apache.
# Garder false pour interdire toute mutation de schéma pendant une requête HTTP.
TUGERES_ALLOW_HTTP_MIGRATIONS=false
# Nombre de tentatives au démarrage uniquement si MySQL n'est pas encore joignable.
MIGRATION_STARTUP_ATTEMPTS=5

# Ne faire confiance à CF-Connecting-IP / X-Forwarded-For que derrière un proxy maîtrisé.
# Laisser false en accès direct. Sur Railway, activer uniquement après vérification du chemin proxy.
TRUST_PROXY_HEADERS=false

# Entitlements / licence Tugères
# Transition : legacy conserve la compatibilité actuelle mais n'est pas une barrière de sécurité.
# Production commerciale : provisionner d'abord une licence signée, puis passer à signed.
TUGERES_ENTITLEMENTS_MODE=legacy
# Clé publique PEM encodée en base64. La clé privée ne doit jamais être déployée sur l'instance traiteur.
TUGERES_LICENSE_PUBLIC_KEY_B64=

# Cloudinary (uploads persistants — https://cloudinary.com)
# Requis en production (Railway filesystem éphémère)
# Sans ces variables, les uploads sont stockés dans public/uploads/ (local uniquement)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AkikSystems SaaS Dashboard (admin-saas/)
# Token secret pour protéger le dashboard de provisioning
# Générer avec : php -r "echo bin2hex(random_bytes(32));"
SAAS_SECRET=
