# ============================================
# TUGERES — Variables d'environnement
# Une instance isolée par traiteur
# Copier vers .env en local et remplir les valeurs
# NE JAMAIS COMMITER .env
# ============================================

# Base de données MySQL
DB_HOST=localhost
DB_NAME=vite_gourmand
DB_USER=root
DB_PASS=

# Stripe
# sk_test_/pk_test_ en validation, sk_live_/pk_live_ en production commerciale.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secret du webhook Stripe configuré sur POST <BASE_URL>/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Email — transport actif : API HTTP Brevo
# L'adresse MAIL_FROM doit être autorisée côté Brevo.
BREVO_API_KEY=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Mon Traiteur

# Application
BASE_URL=http://localhost:8080
APP_ENV=development
# Production : APP_ENV=production

# Cycle de vie des migrations
# Production : les migrations sont exécutées par l'entrypoint Docker avant Apache.
# Garder false pour interdire toute mutation de schéma pendant une requête HTTP.
TUGERES_ALLOW_HTTP_MIGRATIONS=false
# Nombre de tentatives au démarrage uniquement si MySQL n'est pas encore joignable.
MIGRATION_STARTUP_ATTEMPTS=5

# Ne faire confiance à CF-Connecting-IP / X-Forwarded-For que derrière un proxy maîtrisé.
# Laisser false tant que le chemin proxy de l'hébergeur n'a pas été validé.
TRUST_PROXY_HEADERS=false

# Entitlements / licence Tugères
# legacy = compatibilité de transition.
# signed = mode attendu pour une instance commerciale avec licence provisionnée.
TUGERES_ENTITLEMENTS_MODE=legacy
# Clé publique PEM encodée en base64. La clé privée ne doit jamais être déployée chez le traiteur.
TUGERES_LICENSE_PUBLIC_KEY_B64=

# Cloudinary — stockage durable des images métier
# Sans ces variables, les uploads restent locaux au filesystem du conteneur.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AkikSystems SaaS Dashboard historique (admin-saas/)
# Générer un secret long aléatoire si cette interface est utilisée.
SAAS_SECRET=
